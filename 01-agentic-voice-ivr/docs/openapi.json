{
  "openapi": "3.1.0",
  "info": {
    "title": "Agentic Voice IVR",
    "description": "\nAgentic conversational IVR for a (fictional) fiber ISP, Northwind Fiber.\n\n* **/v1** \u2013 JSON API used by the simulator, eval harness and other services (`X-API-Key`).\n* **/voice/twilio** \u2013 Twilio Programmable Voice webhooks returning TwiML (signature-validated).\n\nAll enterprise systems are **simulated** with synthetic data. See the README for which\nintegrations are live-tested and which are not.\n",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Liveness probe",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Live Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Readiness probe (checks downstream adapters)",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Ready Health Ready Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/calls": {
      "post": {
        "tags": [
          "calls"
        ],
        "summary": "Start a simulated call",
        "operationId": "start_call_v1_calls_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/StartCallRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallView"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/calls/{call_id}/turns": {
      "post": {
        "tags": [
          "calls"
        ],
        "summary": "Send one caller utterance",
        "operationId": "take_turn_v1_calls__call_id__turns_post",
        "parameters": [
          {
            "name": "call_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Call Id"
            }
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TurnRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallView"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/calls/{call_id}": {
      "get": {
        "tags": [
          "calls"
        ],
        "summary": "Call state and tool audit trail",
        "operationId": "get_call_v1_calls__call_id__get",
        "parameters": [
          {
            "name": "call_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Call Id"
            }
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallDetail"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tools": {
      "get": {
        "tags": [
          "calls"
        ],
        "summary": "Tool catalog (JSON schemas usable for LLM tool calling)",
        "operationId": "list_tools_v1_tools_get",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "title": "Response List Tools V1 Tools Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/voice/twilio/incoming": {
      "post": {
        "tags": [
          "voice: twilio"
        ],
        "summary": "Twilio voice webhook: new inbound call",
        "operationId": "incoming_voice_twilio_incoming_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/voice/twilio/gather": {
      "post": {
        "tags": [
          "voice: twilio"
        ],
        "summary": "Twilio Gather action: one caller turn (speech or DTMF)",
        "operationId": "gather_voice_twilio_gather_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CallDetail": {
        "properties": {
          "call_id": {
            "type": "string",
            "title": "Call Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "in_progress",
              "completed",
              "escalated"
            ],
            "title": "Status"
          },
          "reply": {
            "type": "string",
            "title": "Reply"
          },
          "turn": {
            "type": "integer",
            "title": "Turn"
          },
          "intent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Intent"
          },
          "nlu_source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nlu Source"
          },
          "expecting": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expecting"
          },
          "active_intent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Intent"
          },
          "authenticated": {
            "type": "boolean",
            "title": "Authenticated"
          },
          "awaiting_confirmation": {
            "type": "boolean",
            "title": "Awaiting Confirmation"
          },
          "completed_tasks": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Completed Tasks"
          },
          "handoff": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Handoff"
          },
          "events": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Events"
          }
        },
        "type": "object",
        "required": [
          "call_id",
          "status",
          "reply",
          "turn",
          "intent",
          "nlu_source",
          "expecting",
          "active_intent",
          "authenticated",
          "awaiting_confirmation",
          "completed_tasks",
          "handoff",
          "events"
        ],
        "title": "CallDetail",
        "examples": [
          {
            "authenticated": true,
            "awaiting_confirmation": false,
            "call_id": "CA3f2c...",
            "completed_tasks": [
              "check_balance"
            ],
            "intent": "provide_info",
            "nlu_source": "rules",
            "reply": "Thanks, Ava, you're verified. Your current balance is $89.99, due on November 9. Is there anything else I can help you with?",
            "status": "in_progress",
            "turn": 3
          }
        ]
      },
      "CallView": {
        "properties": {
          "call_id": {
            "type": "string",
            "title": "Call Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "in_progress",
              "completed",
              "escalated"
            ],
            "title": "Status"
          },
          "reply": {
            "type": "string",
            "title": "Reply"
          },
          "turn": {
            "type": "integer",
            "title": "Turn"
          },
          "intent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Intent"
          },
          "nlu_source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nlu Source"
          },
          "expecting": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expecting"
          },
          "active_intent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Intent"
          },
          "authenticated": {
            "type": "boolean",
            "title": "Authenticated"
          },
          "awaiting_confirmation": {
            "type": "boolean",
            "title": "Awaiting Confirmation"
          },
          "completed_tasks": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Completed Tasks"
          },
          "handoff": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Handoff"
          }
        },
        "type": "object",
        "required": [
          "call_id",
          "status",
          "reply",
          "turn",
          "intent",
          "nlu_source",
          "expecting",
          "active_intent",
          "authenticated",
          "awaiting_confirmation",
          "completed_tasks",
          "handoff"
        ],
        "title": "CallView",
        "examples": [
          {
            "authenticated": true,
            "awaiting_confirmation": false,
            "call_id": "CA3f2c...",
            "completed_tasks": [
              "check_balance"
            ],
            "intent": "provide_info",
            "nlu_source": "rules",
            "reply": "Thanks, Ava, you're verified. Your current balance is $89.99, due on November 9. Is there anything else I can help you with?",
            "status": "in_progress",
            "turn": 3
          }
        ]
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "StartCallRequest": {
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "api",
              "simulator"
            ],
            "title": "Channel",
            "default": "api"
          }
        },
        "type": "object",
        "title": "StartCallRequest"
      },
      "TurnRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 500,
            "title": "Text",
            "description": "Caller utterance as transcribed by ASR, or DTMF digits.",
            "default": ""
          }
        },
        "type": "object",
        "title": "TurnRequest",
        "examples": [
          {
            "text": "what's my balance"
          }
        ]
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}

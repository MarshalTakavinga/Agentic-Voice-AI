# Copy to .env and adjust. Every setting is read with the IVR_ prefix (see app/config.py).
IVR_ENV=local
IVR_LOG_LEVEL=INFO

# Required header for /v1 endpoints. Generate a real one: python -c "import secrets;print(secrets.token_urlsafe(32))"
IVR_API_KEY=change-me-local-only

# NLU: rules (default, free, deterministic) | openai_compatible | bedrock
IVR_NLU_PROVIDER=rules
# openai_compatible works with Ollama (free/local), vLLM, OpenAI or Azure OpenAI
IVR_LLM_BASE_URL=http://localhost:11434/v1
IVR_LLM_MODEL=llama3.1:8b
IVR_LLM_API_KEY=
IVR_LLM_TIMEOUT_S=4.0
IVR_LLM_MIN_CONFIDENCE=0.5
# bedrock: pip install ".[bedrock]", configure AWS credentials, set a model ID enabled in your account
IVR_BEDROCK_MODEL_ID=
IVR_AWS_REGION=us-east-1

# Conversation policy
# Claude planner (Milestone 2). Off unless enabled and keyed.
IVR_PLANNER_ENABLED=false
IVR_ANTHROPIC_API_KEY=
IVR_PLANNER_DAILY_BUDGET_USD=1.0
IVR_PLANNER_MAX_TURNS_PER_CALL=8

# Shared state (Milestone 3). memory = single process; redis = replicas share state.
IVR_STATE_BACKEND=memory
IVR_REDIS_URL=redis://localhost:6379/0
IVR_LOCKOUT_MAX_FAILURES=5
IVR_LOCKOUT_WINDOW_S=900

IVR_MAX_AUTH_ATTEMPTS=3
IVR_MAX_NO_MATCH=3
IVR_SESSION_TTL_S=1800

# Twilio voice channel. Turn validation ON whenever the endpoint is reachable from the internet.
IVR_TWILIO_VALIDATE_SIGNATURE=false
IVR_TWILIO_AUTH_TOKEN=
IVR_PUBLIC_BASE_URL=
IVR_TTS_VOICE=Polly.Joanna

# Print OpenTelemetry spans to stdout
IVR_OTEL_CONSOLE_EXPORTER=false

[
  {
    "id": "balance_spoken_digits",
    "description": "Caller asks for balance; account and PIN spoken as words.",
    "turns": [
      {"say": "I want to check my balance", "expect": "account number"},
      {"say": "one zero zero zero zero zero zero one", "expect": "PIN"},
      {"say": "one two three four", "expect": "$89.99"},
      {"say": "no that's all", "expect": "Goodbye"}
    ],
    "expect": {"status": "completed", "completed_tasks": ["check_balance"], "authenticated": true}
  },
  {
    "id": "balance_dtmf_menu",
    "description": "Legacy DTMF caller presses 1, then keys account and PIN.",
    "turns": [
      {"say": "1", "expect": "account number"},
      {"say": "10000001"},
      {"say": "1234", "expect": "$89.99"}
    ],
    "expect": {"status": "in_progress", "completed_tasks": ["check_balance"]}
  },
  {
    "id": "credentials_in_one_utterance",
    "description": "Caller volunteers account and PIN together.",
    "turns": [
      {"say": "check my balance"},
      {"say": "my account number is 10000002 and my pin is 4321", "expect": "$42.50"}
    ],
    "expect": {"completed_tasks": ["check_balance"]}
  },
  {
    "id": "outage_no_auth_required",
    "description": "Outage lookup is public information and needs no identity verification.",
    "turns": [
      {"say": "is there an outage", "expect": "ZIP code"},
      {"say": "seven three three zero one", "expect": "known service outage"}
    ],
    "expect": {"completed_tasks": ["check_outage"], "authenticated": false}
  },
  {
    "id": "outage_none_found",
    "description": "No outage in the caller's area; IVR offers a technician.",
    "turns": [
      {"say": "my internet is down"},
      {"say": "zip code 60614", "expect": "not seeing any reported outage"}
    ],
    "expect": {"completed_tasks": ["check_outage"]}
  },
  {
    "id": "multi_task_context_carryover",
    "description": "After verifying for billing, the outage check reuses the account's service ZIP.",
    "turns": [
      {"say": "balance"},
      {"say": "10000001"},
      {"say": "1234", "expect": "$89.99"},
      {"say": "is there an outage in my area", "expect": "known service outage"}
    ],
    "expect": {"completed_tasks": ["check_balance", "check_outage"]}
  },
  {
    "id": "schedule_and_confirm",
    "description": "Side-effecting booking only happens after explicit confirmation.",
    "turns": [
      {"say": "I need a technician to come out"},
      {"say": "10000002"},
      {"say": "4321", "expect": "Would you like me to book it"},
      {"say": "yes please", "expect": "confirmation number"}
    ],
    "expect": {"completed_tasks": ["schedule_technician"]}
  },
  {
    "id": "schedule_decline_then_choose_day",
    "description": "Caller declines the first offer and names a weekday.",
    "turns": [
      {"say": "schedule a repair visit"},
      {"say": "10000002"},
      {"say": "4321", "expect": "book it"},
      {"say": "no", "expect": "won't book"},
      {"say": "how about friday", "expect": "Friday"},
      {"say": "yes", "expect": "confirmation number"}
    ],
    "expect": {"completed_tasks": ["schedule_technician"]}
  },
  {
    "id": "intent_switch_mid_flow",
    "description": "Caller abandons scheduling for an outage check before authenticating.",
    "turns": [
      {"say": "schedule a technician", "expect": "account number"},
      {"say": "actually is there an outage", "expect": "ZIP code"},
      {"say": "73301", "expect": "known service outage"}
    ],
    "expect": {"completed_tasks": ["check_outage"], "authenticated": false}
  },
  {
    "id": "auth_failure_escalates",
    "description": "Three failed verifications route to a human, without saying which field was wrong.",
    "turns": [
      {"say": "balance please"},
      {"say": "10000001"},
      {"say": "0000", "expect": "didn't match"},
      {"say": "10000001"},
      {"say": "1111", "expect": "didn't match"},
      {"say": "10000001"},
      {"say": "2222", "expect": "specialist"}
    ],
    "expect": {"status": "escalated", "handoff_reason": "auth_failed", "handoff_queue": "billing",
               "authenticated": false}
  },
  {
    "id": "caller_requests_human",
    "description": "An explicit request for a person is honored immediately.",
    "turns": [{"say": "let me talk to a real person", "expect": "specialist"}],
    "expect": {"status": "escalated", "handoff_reason": "caller_requested",
               "handoff_queue": "general"}
  },
  {
    "id": "no_match_escalates",
    "description": "Repeated unintelligible input escalates after the no-match limit.",
    "turns": [
      {"say": "purple monkey dishwasher", "expect": "didn't catch"},
      {"say": "asdf qwerty", "expect": "didn't catch"},
      {"say": "banana", "expect": "trouble understanding"}
    ],
    "expect": {"status": "escalated", "handoff_reason": "no_match"}
  },
  {
    "id": "upstream_failure_escalates",
    "description": "Billing system timeout degrades to a warm transfer instead of a dead end.",
    "turns": [
      {"say": "what do I owe"},
      {"say": "10000099"},
      {"say": "9999", "expect": "trouble reaching"}
    ],
    "expect": {"status": "escalated", "handoff_reason": "system_error",
               "handoff_queue": "billing", "authenticated": true}
  },
  {
    "id": "silence_reprompts_for_slot",
    "description": "Empty input (Twilio Gather timeout) reprompts for the slot being collected.",
    "turns": [
      {"say": "balance"},
      {"say": "", "expect": "eight digit account number"}
    ],
    "expect": {"status": "in_progress"}
  }
]

# Copy to .env. Every setting uses the SIPDOC_ prefix (see sipdoc/config.py).
SIPDOC_ENV=local
SIPDOC_LOG_LEVEL=INFO
SIPDOC_API_KEY=change-me-local-only
SIPDOC_MAX_UPLOAD_MB=20
SIPDOC_MAX_STORED_ANALYSES=100

# Narrator: template (deterministic, default) | openai_compatible (Ollama, vLLM, OpenAI)
SIPDOC_NARRATOR=template
SIPDOC_LLM_BASE_URL=http://localhost:11434/v1
SIPDOC_LLM_MODEL=llama3.1:8b
SIPDOC_LLM_API_KEY=
SIPDOC_LLM_TIMEOUT_S=8.0
